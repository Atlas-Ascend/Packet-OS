{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ghostatlas.local/contracts/gaqc-decision.schema.json",
  "title": "GAQC Quality Decision",
  "type": "object",
  "required": ["inspected", "disposition", "reasons"],
  "properties": {
    "inspected": {"type": "boolean"},
    "disposition": {
      "enum": ["BYPASS_TO_SECA", "PASS_TO_SECA", "REWORK", "QUARANTINE", "ESCALATE"]
    },
    "reasons": {"type": "array", "items": {"type": "string"}},
    "missing_evidence": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "defects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "severity"],
        "properties": {
          "code": {"type": "string", "minLength": 1},
          "severity": {"enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]},
          "detail": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
