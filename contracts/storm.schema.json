{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ghostatlas.local/contracts/packet-storm.schema.json",
  "title": "Ghost Atlas Packet Storm",
  "type": "object",
  "required": ["storm_id", "max_packets", "admission_batch", "lanes", "packets"],
  "properties": {
    "storm_id": {"type": "string", "minLength": 1},
    "max_packets": {"type": "integer", "minimum": 1},
    "admission_batch": {"type": "integer", "minimum": 1},
    "lanes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "concurrency", "queue_limit", "weight"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "concurrency": {"type": "integer", "minimum": 1},
          "queue_limit": {"type": "integer", "minimum": 1},
          "weight": {"type": "integer", "minimum": 1},
          "paused": {"type": "boolean"}
        },
        "additionalProperties": true
      }
    },
    "packets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "objective", "lane", "acceptance_criteria", "risk"],
        "properties": {
          "key": {"type": "string", "minLength": 1},
          "objective": {"type": "string", "minLength": 1},
          "lane": {"type": "string", "minLength": 1},
          "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "depends_on": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "risk": {"enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]},
          "priority": {"type": "integer", "minimum": 0, "maximum": 100},
          "idempotency_key": {"type": ["string", "null"]}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
